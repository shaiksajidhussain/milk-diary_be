DATABASE_URL="postgresql://tracker:tracker@localhost:5432/expense_tracker?schema=public"


JWT_SECRET="supersecretkey"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"
PORT=4000

# Extra CORS origins (comma-separated). Paths are ignored — use origin only, e.g. https://kovamall.vercel.app
# FRONTEND_ORIGIN="https://kovamall.vercel.app"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Gmail SMTP — sender kovamall001@gmail.com (use App Password, not normal password)
MAIL_FROM="kovamall001@gmail.com"
MAIL_FROM_NAME="Kovamall"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="kovamall001@gmail.com"
SMTP_PASS=""

# WhatsApp Web (jugaad) — uses Google Chrome via Puppeteer; scan QR once per server
WHATSAPP_ENABLED=false
# Chrome for Puppeteer (required on Linux servers; auto-detected on Mac if unset)
# CHROME_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# Session stored under .wwebjs_auth with clientId "main" (reduces session corruption)
