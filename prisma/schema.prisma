generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FarmerStatus {
  active
  inactive
}

enum CollectionSession {
  Morning
  Evening
}

model Admin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Farmer {
  id          String           @id @default(uuid())
  farmerCode  String           @unique @map("farmer_code")
  name        String
  mobile      String
  email       String?
  village     String
  qrCode      String           @unique @map("qr_code")
  status      FarmerStatus     @default(active)
  createdAt   DateTime         @default(now()) @map("created_at")
  collections MilkCollection[]

  @@index([village])
  @@index([status])
  @@index([name])
  @@map("farmers")
}

model MilkCollection {
  id                  String            @id @default(uuid())
  farmerId            String            @map("farmer_id")
  farmer              Farmer            @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  weight              Decimal           @db.Decimal(12, 2)
  session             CollectionSession
  collectedAt         DateTime          @default(now()) @map("collected_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  /** Optional JPEG/PNG data URL of the weighing machine display (client-resized). */
  scalePhotoDataUrl   String?           @map("scale_photo_data_url") @db.Text

  @@index([farmerId])
  @@index([collectedAt])
  @@index([session])
  @@map("milk_collections")
}

